generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserType {
  STUDENT
  STAFF
  ADMINISTRATOR
}

enum OtpPurpose {
  REGISTRATION
  PASSWORD_RESET
  COMPLETION
}

enum ServiceRole {
  CLEANING
  ELECTRICAL_MAINTENANCE
  PLUMBING
  AC_MAINTENANCE
  FURNITURE_REPAIR
}

enum RequestStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ComplaintStatus {
  SUBMITTED
  UNDER_REVIEW
  RESOLVED
  CLOSED
}

enum Priority {
  LOW
  NORMAL
  HIGH
}

enum NotificationType {
  AUTHENTICATION
  SERVICE_REQUEST
  COMPLAINT
  FEEDBACK
  SYSTEM
}

model HostelBlock {
  id          Int       @id @default(autoincrement())
  blockName   String    @unique @db.VarChar(20) @map("block_name")
  description String?   @db.VarChar(200)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  students    Student[]
  staff       Staff[]

  @@map("hostel_block")
}

model Student {
  id                 Int              @id @default(autoincrement())
  registrationNumber String           @unique @db.VarChar(30) @map("registration_number")
  fullName           String           @db.VarChar(100) @map("full_name")
  email              String           @unique @db.VarChar(150)
  phoneNumber        String?          @db.VarChar(20) @map("phone_number")
  roomNumber         String           @db.VarChar(20) @map("room_number")
  floor              Int              @default(0)
  blockId            Int              @map("block_id")
  isBlocked          Boolean          @default(false) @map("is_blocked")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  block              HostelBlock      @relation(fields: [blockId], references: [id], onUpdate: Cascade, onDelete: Restrict)
  serviceRequests    ServiceRequest[]
  complaints         Complaint[]
  feedback           Feedback[]

  @@index([blockId])
  @@map("student")
}

model Staff {
  id               Int              @id @default(autoincrement())
  fullName         String           @db.VarChar(100) @map("full_name")
  email            String           @unique @db.VarChar(150)
  serviceRole      ServiceRole      @map("service_role")
  primaryRole      ServiceRole      @default(CLEANING) @map("primary_role")
  secondaryRole    ServiceRole?     @map("secondary_role")
  floor            Int?
  currentWorkload  Float            @default(0.0) @map("current_workload")
  blockId          Int              @map("block_id")
  isActive         Boolean          @default(true) @map("is_active")
  phoneNumber      String?          @db.VarChar(20) @map("phone_number")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  block            HostelBlock      @relation(fields: [blockId], references: [id], onUpdate: Cascade, onDelete: Restrict)
  assignedRequests ServiceRequest[] @relation("AssignedStaff")
  feedback         Feedback[]
  categoryStats    StaffCategoryStats[]

  @@index([blockId])
  @@index([serviceRole])
  @@map("staff")
}

model Administrator {
  id                 Int        @id @default(autoincrement())
  username           String     @unique @db.VarChar(50)
  fullName           String     @db.VarChar(100) @map("full_name")
  email              String?    @unique @db.VarChar(150)
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")
  resolvedComplaints Complaint[] @relation("ComplaintResolver")
  auditLogs          AuditLog[]

  @@map("administrator")
}

model AccountCredential {
  id                 Int      @id @default(autoincrement())
  userType           UserType @map("user_type")
  userId             Int      @map("user_id")
  email              String   @unique @db.VarChar(150)
  passwordHash       String   @db.VarChar(255) @map("password_hash")
  emailVerified      Boolean  @default(false) @map("email_verified")
  lastPasswordChange DateTime? @map("last_password_change")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@unique([userType, userId])
  @@index([userId])
  @@map("account_credentials")
}

model OtpVerification {
  id        Int        @id @default(autoincrement())
  userType  UserType   @map("user_type")
  userId    Int?       @map("user_id")
  payload   String?    @db.Text
  otpCode   String     @db.VarChar(10) @map("otp_code")
  purpose   OtpPurpose
  attempts  Int        @default(0)
  expiresAt DateTime   @map("expires_at")
  verifiedAt DateTime? @map("verified_at")
  createdAt DateTime   @default(now()) @map("created_at")

  @@index([userId])
  @@index([expiresAt])
  @@index([userType, userId, purpose])
  @@map("otp_verification")
}

model ServiceCategory {
  id           Int              @id @default(autoincrement())
  categoryName String           @unique @db.VarChar(50) @map("category_name")
  serviceRole  ServiceRole      @unique @map("service_role")
  description  String?          @db.VarChar(200)
  isActive     Boolean          @default(true) @map("is_active")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  requests     ServiceRequest[]
  staffStats   StaffCategoryStats[]

  @@map("service_category")
}

model ServiceRequest {
  id              Int           @id @default(autoincrement())
  studentId       Int           @map("student_id")
  categoryId      Int           @map("category_id")
  assignedStaffId Int?          @map("assigned_staff_id")
  title           String        @db.VarChar(150)
  description     String
  roomNumber      String        @db.VarChar(20) @map("room_number")
  requestStatus   RequestStatus @default(PENDING) @map("request_status")
  priority        Priority      @default(NORMAL)
  assignedAt      DateTime?     @map("assigned_at")
  startedAt       DateTime?     @map("started_at")
  completedAt     DateTime?     @map("completed_at")
  cancelledAt     DateTime?     @map("cancelled_at")
  pausedDuration  Int?          @map("paused_duration")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  student         Student       @relation(fields: [studentId], references: [id], onUpdate: Cascade, onDelete: Restrict)
  category        ServiceCategory @relation(fields: [categoryId], references: [id], onUpdate: Cascade, onDelete: Restrict)
  assignedStaff   Staff?        @relation("AssignedStaff", fields: [assignedStaffId], references: [id], onUpdate: Cascade, onDelete: SetNull)
  feedback        Feedback?

  @@index([studentId])
  @@index([assignedStaffId])
  @@index([requestStatus])
  @@index([categoryId])
  @@index([createdAt])
  @@map("service_request")
}

model ComplaintCategory {
  id           Int         @id @default(autoincrement())
  categoryName String      @unique @db.VarChar(50) @map("category_name")
  description  String?     @db.VarChar(200)
  isActive     Boolean     @default(true) @map("is_active")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")
  complaints   Complaint[]

  @@map("complaint_category")
}

model Complaint {
  id              Int             @id @default(autoincrement())
  studentId       Int             @map("student_id")
  categoryId      Int             @map("category_id")
  title           String          @db.VarChar(150)
  description     String
  complaintStatus ComplaintStatus @default(SUBMITTED) @map("complaint_status")
  priority        Priority        @default(NORMAL)
  resolvedBy      Int?            @map("resolved_by")
  resolutionNotes String?         @map("resolution_notes")
  resolvedAt      DateTime?       @map("resolved_at")
  closedAt        DateTime?       @map("closed_at")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  student         Student         @relation(fields: [studentId], references: [id], onUpdate: Cascade, onDelete: Restrict)
  category        ComplaintCategory @relation(fields: [categoryId], references: [id], onUpdate: Cascade, onDelete: Restrict)
  resolver        Administrator?  @relation("ComplaintResolver", fields: [resolvedBy], references: [id], onUpdate: Cascade, onDelete: Restrict)

  @@index([studentId])
  @@index([complaintStatus])
  @@index([categoryId])
  @@index([resolvedBy])
  @@index([createdAt])
  @@map("complaint")
}

model Feedback {
  id          Int            @id @default(autoincrement())
  requestId   Int            @unique @map("request_id")
  studentId   Int            @map("student_id")
  staffId     Int            @map("staff_id")
  rating      Int
  comments    String?
  submittedAt DateTime       @default(now()) @map("submitted_at")
  createdAt   DateTime       @default(now()) @map("created_at")
  request     ServiceRequest @relation(fields: [requestId], references: [id], onUpdate: Cascade, onDelete: Restrict)
  student     Student        @relation(fields: [studentId], references: [id], onUpdate: Cascade, onDelete: Restrict)
  staff       Staff          @relation(fields: [staffId], references: [id], onUpdate: Cascade, onDelete: Restrict)

  @@index([staffId])
  @@index([studentId])
  @@index([submittedAt])
  @@map("feedback")
}

model AuditLog {
  id             Int           @id @default(autoincrement())
  administratorId Int           @map("administrator_id")
  action         String        @db.VarChar(100)
  targetTable    String        @db.VarChar(50) @map("target_table")
  targetRecordId Int?          @map("target_record_id")
  description    String?
  ipAddress      String?       @db.VarChar(45) @map("ip_address")
  createdAt      DateTime      @default(now()) @map("created_at")
  administrator  Administrator @relation(fields: [administratorId], references: [id], onUpdate: Cascade, onDelete: Restrict)

  @@index([administratorId])
  @@index([action])
  @@index([targetTable])
  @@index([createdAt])
  @@map("audit_log")
}

model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int              @map("user_id")
  role      UserType
  title     String           @db.VarChar(150)
  message   String
  type      NotificationType
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at")

  @@index([role, userId, isRead])
  @@index([createdAt])
  @@map("notification")
}

model StaffCategoryStats {
  id             Int             @id @default(autoincrement())
  staffId        Int             @map("staff_id")
  categoryId     Int             @map("category_id")
  completedCount Int             @default(0) @map("completed_count")
  averageTime    Float           @default(0.0) @map("average_time")
  staff          Staff           @relation(fields: [staffId], references: [id], onDelete: Cascade)
  category       ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([staffId, categoryId])
  @@map("staff_category_stats")
}

