POSTGRES_DB=roombot
POSTGRES_USER=roombot
POSTGRES_PASSWORD=change_this_database_password
DATABASE_URL=postgresql://roombot:change_this_database_password@postgres:5432/roombot?schema=public
PORT=5000
NODE_ENV=development
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=24h
OTP_EXPIRY_MINUTES=10
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
EMAIL_FROM=Room-Bot Service <no-reply@example.com>
CLIENT_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:5000/api/v1
VITE_APP_NAME=Room-Bot Service
VITE_ENVIRONMENT=development

